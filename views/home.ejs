
<% layout('boilerplate') %>

<div class="container py-4">
    <h1 class="mb-2">YelpCamp</h1>
    <p class="text-muted mb-4">
        Explore beautiful campgrounds and plan your next adventure.
    </p>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>All Campgrounds</h2>
        <a href="/campgrounds/new" class="btn btn-success">
            + Add Campground
        </a>
    </div>

    <div class="list-group">
        <% campgrounds.forEach(campground => { %>
            <a
                href="/campgrounds/<%= campground._id %>"
                class="list-group-item list-group-item-action py-3"
            >
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1"><%= campground.title %></h5>
                        <small class="text-muted">
                            <%= campground.location %>
                        </small>
                    </div>

                    <span class="text-success fw-semibold">
                        View Details →
                    </span>
                </div>
            </a>
        <% }) %>
    </div>

    <% if (campgrounds.length === 0) { %>
        <p class="text-muted mt-3">
            No campgrounds yet. Add your first campground!
        </p>
    <% } %>
</div>
